# Required in production
NODE_ENV=production
HEARTBEAT_PUBLIC_URL=https://heartbeat.example.org
DATABASE_URL=postgres://heartbeat_app:...@db.example.org/heartbeat
# 32 random bytes, base64 (npm run cli -- genkey). Wraps every participant data key. Keep it in a secrets manager, not in backups.
HEARTBEAT_MASTER_KEY=
# Long random string for CSRF tokens and keyed hashes
HEARTBEAT_SECRET=

# Optional: separate connections (recommended in production, see docs/OPERATIONS.md)
# RETENTION_DATABASE_URL=postgres://heartbeat_retention:...@db.example.org/heartbeat   # only role allowed to purge audit rows
# KEYSTORE_DATABASE_URL=postgres://heartbeat_keys:...@keys.example.org/heartbeat_keys  # participant data keys, backed up separately with short retention

# Email for staff notifications (generic text only)
# HEARTBEAT_SMTP_URL=smtps://user:pass@smtp.example.org:465
# HEARTBEAT_MAIL_FROM=Heartbeat <heartbeat@example.org>

# Text messages and keypad check-ins (Twilio-compatible). Webhook signatures are always verified in production.
# HEARTBEAT_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# HEARTBEAT_AUDIT_EXPORT_DIR=/mnt/audit-export   # write-once storage the app cannot overwrite
# HEARTBEAT_WORKERS=1                             # run scheduled jobs in the web process (or run `npm run worker` separately and set 0 here)
# HEARTBEAT_TRUST_PROXY=1
# PORT=8080
